# Public CMS content requires no WordPress credentials.
WORDPRESS_URL=https://people.smu.edu/daslab
# Disable only for an explicitly labeled offline preview.
WORDPRESS_ENABLED=true
# Set to the final frontend origin before deployment.
SITE_URL=http://localhost:3000

# Optional admin workspace. Generate a fresh 32-byte base64 key per environment.
# WordPress usernames/Application Passwords are entered at sign-in, never stored here.
ADMIN_ENABLED=false
ADMIN_SESSION_SECRET=
